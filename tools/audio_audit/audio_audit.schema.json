{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:godot-story-foundation:audio-technical-report:v1",
  "title": "Audio technical measurements; never listening acceptance",
  "type": "object",
  "required": ["schema_version", "generated_at", "tool_versions", "policy", "policy_basis", "evidence_kind", "perception_verified", "listening_status", "limit_claims", "assets", "summary"],
  "properties": {
    "schema_version": {"const": "audio-technical-report.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool_versions": {"type": "object"},
    "policy": {"type": "object", "additionalProperties": {"type": "number"}},
    "policy_basis": {"type": "string"},
    "evidence_kind": {"const": "local_decoded_pcm_measurement"},
    "perception_verified": {"const": false},
    "listening_status": {"const": "not_assessed"},
    "limit_claims": {"type": "array", "items": {"type": "string"}},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "summary": {"type": "object", "required": ["assets", "pass", "warn", "fail"], "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "path", "category", "loop", "source_sha256", "policy", "decode", "format", "metrics", "loop_risk", "findings", "technical_status", "evidence_kind", "perception_verified", "listening_status"],
      "properties": {
        "id": {"type": "string"}, "path": {"type": "string"}, "category": {"type": "string"}, "loop": {"type": "boolean"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "policy": {"type": "object"},
        "decode": {"type": "object", "required": ["status", "error"], "properties": {"status": {"enum": ["not_run", "passed", "failed"]}, "error": {"type": ["string", "null"]}}},
        "format": {"type": "object"},
        "metrics": {"type": "object", "description": "Empty on failure. Zero-amplitude dBFS is null, never Infinity. Per-channel measurements are preserved; no downmix cancellation. true_peak_dbfs and integrated_lufs are null/not_measured in v1."},
        "loop_risk": {"type": "object", "required": ["status", "perception_verified"], "properties": {"status": {"enum": ["not_assessed", "not_requested", "risk_flagged", "no_risk_flagged"]}, "perception_verified": {"const": false}}},
        "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "code", "message"], "properties": {"severity": {"enum": ["error", "warning"]}, "code": {"type": "string"}, "message": {"type": "string"}}}},
        "technical_status": {"enum": ["pass", "warn", "fail"]},
        "evidence_kind": {"const": "local_decoded_pcm_measurement"},
        "perception_verified": {"const": false}, "listening_status": {"const": "not_assessed"}
      }
    }
  }
}
